27:30","/trips/2025-11-levant-ii/photos/IMG_2681.jpeg",{"slug":20,"title":62,"description":63,"datePosted":64,"photos":65},"Erbil 🇮🇶","The capital of Iraqi Kurdistan.\n\nErbil is a modern city that has rapidly grown into an urban sprawl, and with plenty of Christmas lights.\n\nFollowing in the footsteps of Top Gear's Middle East special, I headed north to Bekhal Waterfall, where its water flows underfoot.","2025-12-10",[66,71,76,81,86,91,96,101],{"slug":67,"title":68,"description":28,"dateTaken":69,"photoUrl":70},"img-2443","IMG_2443","2025-12-09T21:33:56","/trips/2025-11-levant-ii/photos/IMG_2443.jpeg",{"slug":72,"title":73,"description":28,"dateTaken":74,"photoUrl":75},"img-2412","IMG_2412","2025-12-09T20:30:54","/trips/2025-11-levant-ii/photos/IMG_2412.jpeg",{"slug":77,"title":78,"description":28,"dateTaken":79,"photoUrl":80},"img-2485","IMG_2485","2025-12-10T12:14:16","/trips/2025-11-levant-ii/photos/IMG_2485.jpeg",{"slug":82,"title":83,"description":28,"dateTaken":84,"photoUrl":85},"img-2521","IMG_2521","2025-12-10T12:54:08","/trips/2025-11-levant-ii/photos/IMG_2521.jpeg",{"slug":87,"title":88,"description":28,"dateTaken":89,"photoUrl":90},"img-2545","IMG_2545","2025-12-10T14:35:12","/trips/2025-11-levant-ii/photos/IMG_2545.jpeg",{"slug":92,"title":93,"description":28,"dateTaken":94,"photoUrl":95},"img-2573","IMG_2573","2025-12-10T19:20:43","/trips/2025-11-levant-ii/photos/IMG_2573.jpeg",{"slug":97,"title":98,"description":28,"dateTaken":99,"photoUrl":100},"img-2745","IMG_2745","2025-12-13T14:04:54","/trips/2025-11-levant-ii/photos/IMG_2745.jpeg",{"slug":102,"title":103,"description":28,"dateTaken":104,"photoUrl":105},"img-2797","IMG_2797","2025-12-13T23:22:27","/trips/2025-11-levant-ii/photos/IMG_2797.jpeg",{"slug":107,"title":108,"description":109,"datePosted":110,"photos":111},"po_22cdded5-2c5f-47e7-8b4e-16e2c155712a","Northern Lebanon 🇱🇧","After returning to Beirut on Dec 6, I travelled north to Tripoli. It's much cheaper than Beirut—in the souks, you could buy a kilogram of vibrant, ripe tomatoes for just £50,000 LBP ($0.56 USD).\n\nAfter, we headed up the mountain to Bcharre, where you can find Qadisha Valley and the Cedars of God. Perched upon a cliff is the Monastery of Mar Lishaa, with its many chapels cut into the rock face.","2025-12-07",[112,117,122,127,132],{"slug":113,"title":114,"description":28,"dateTaken":115,"photoUrl":116},"img-2221","IMG_2221","2025-12-07T14:22:10","/trips/2025-11-levant-ii/photos/IMG_2221.jpeg",{"slug":118,"title":119,"description":28,"dateTaken":120,"photoUrl":121},"img-2054","IMG_2054","2025-12-07T10:07:53","/trips/2025-11-levant-ii/photos/IMG_2054.jpeg",{"slug":123,"title":124,"description":28,"dateTaken":125,"photoUrl":126},"img-2130","IMG_2130","2025-12-07T12:08:33","/trips/2025-11-levant-ii/photos/IMG_2130.jpeg",{"slug":128,"title":129,"description":28,"dateTaken":130,"photoUrl":131},"img-2185","IMG_2185","2025-12-07T14:03:38","/trips/2025-11-levant-ii/photos/IMG_2185.jpeg",{"slug":133,"title":134,"description":28,"dateTaken":135,"photoUrl":136},"img-2227","IMG_2227","2025-12-07T14:26:55","/trips/2025-11-levant-ii/photos/IMG_2227.jpeg",{"slug":138,"title":139,"description":140,"datePosted":141,"photos":142},"po_a51bbd04-8d22-48dc-8b51-91830f0745b1","Palmyra 🇸🇾","\"The Pearl of the Desert\"—a UNESCO World Heritage site nestled within the heart of the Syrian Desert.","2025-12-05",[143,148,153,158,163,168,173,178,183,188,193],{"slug":144,"title":145,"description":28,"dateTaken":146,"photoUrl":147},"img-1678","IMG_1678","2025-12-05T13:32:47","/trips/2025-11-levant-ii/photos/IMG_1678.jpeg",{"slug":149,"title":150,"description":28,"dateTaken":151,"photoUrl":152},"img-1544","IMG_1544","2025-12-05T10:46:32","/trips/2025-11-levant-ii/photos/IMG_1544.jpeg",{"slug":154,"title":155,"description":28,"dateTaken":156,"photoUrl":157},"img-1593","IMG_1593","2025-12-05T12:11:45","/trips/2025-11-levant-ii/photos/IMG_1593.jpeg",{"slug":159,"title":160,"description":28,"dateTaken":161,"photoUrl":162