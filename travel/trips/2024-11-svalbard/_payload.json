[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"/travel/trips/2024-11-svalbard/":3},{"id":4,"title":5,"contributors":6,"countries":8,"coverPhoto":10,"description":11,"endDate":12,"extension":13,"favourite":14,"meta":15,"owner":7,"posts":16,"red":98,"slug":99,"startDate":100,"stem":101,"tags":102,"__hash__":106},"trips/trips/2024-11-svalbard/index.json","Svalbard",[7],"lewis",[9],"SJ","/trips/2024-11-svalbard/photos/IMG_0718.jpeg","A trip to Svalbard.","2024-12-06T00:00:00.000Z","json",true,{},[17,58],{"slug":18,"title":19,"description":20,"datePosted":21,"photos":22},"po_019b6fc4-0c03-75f2-9ac8-cb57409f8972","78° North","At 78° north, there is no sunrise. There isn’t even twilight. Every hour is the same, save for a little blue time at noon.\n\nThe city and its community are beautiful, with everybody keeping each other sane through the polar night. Its famous restaurants boast unique culinary experiences such as reindeer, seal, and whale.","2024-12-06",[23,28,33,38,43,48,53],{"slug":24,"title":25,"description":26,"dateTaken":27,"photoUrl":10},"img-0718","IMG_0718","","2024-12-03T12:23:00",{"slug":29,"title":30,"description":26,"dateTaken":31,"photoUrl":32},"img-0562","IMG_0562","2024-12-01T11:40:00","/trips/2024-11-svalbard/photos/IMG_0562.jpeg",{"slug":34,"title":35,"description":26,"dateTaken":36,"photoUrl":37},"img-0727","IMG_0727","2024-12-03T20:02:00","/trips/2024-11-svalbard/photos/IMG_0727.jpeg",{"slug":39,"title":40,"description":26,"dateTaken":41,"photoUrl":42},"img-0745","IMG_0745","2024-12-04T10:35:00","/trips/2024-11-svalbard/photos/IMG_0745.jpeg",{"slug":44,"title":45,"description":26,"dateTaken":46,"photoUrl":47},"img-0758","IMG_0758","2024-12-04T11:22:00","/trips/2024-11-svalbard/photos/IMG_0758.jpeg",{"slug":49,"title":50,"description":26,"dateTaken":51,"photoUrl":52},"img-0759","IMG_0759","2024-12-04T11:25:00","/trips/2024-11-svalbard/photos/IMG_0759.jpeg",{"slug":54,"title":55,"description":26,"dateTaken":56,"photoUrl":57},"img-0943","IMG_0943","2024-12-06T14:12:00","/trips/2024-11-svalbard/photos/IMG_0943.jpeg",{"slug":18,"title":59,"description":60,"datePosted":61,"photos":62},"Ice Cave Overnight","Longyearbyen is full of cosy restaurants and hotels, so hiking out for the night was an exercise in seeing how we take heat for granted.\n\nThe cold is merciless. I expected to feel it, but I didn’t anticipate my field meal turning to slush instead of curry, nor my Invisalign to be frozen as I put it back in.","2024-12-05",[63,68,73,78,83,88,93],{"slug":64,"title":65,"description":26,"dateTaken":66,"photoUrl":67},"img-0899","IMG_0899","2024-12-05T11:03:00","/trips/2024-11-svalbard/photos/IMG_0899.jpeg",{"slug":69,"title":70,"description":26,"dateTaken":71,"photoUrl":72},"img-0838","IMG_0838","2024-12-04T22:04:00","/trips/2024-11-svalbard/photos/IMG_0838.jpeg",{"slug":74,"title":75,"description":26,"dateTaken":76,"photoUrl":77},"img-0846","IMG_0846","2024-12-04T22:28:00","/trips/2024-11-svalbard/photos/IMG_0846.jpeg",{"slug":79,"title":80,"description":26,"dateTaken":81,"photoUrl":82},"img-0877","IMG_0877","2024-12-05T08:27:00","/trips/2024-11-svalbard/photos/IMG_0877.jpeg",{"slug":84,"title":85,"description":26,"dateTaken":86,"photoUrl":87},"img-0886","IMG_0886","2024-12-05T08:45:00","/trips/2024-11-svalbard/photos/IMG_0886.jpeg",{"slug":89,"title":90,"description":26,"dateTaken":91,"photoUrl":92},"img-0890","IMG_0890","2024-12-05T09:39:00","/trips/2024-11-svalbard/photos/IMG_0890.jpeg",{"slug":94,"title":95,"description":26,"dateTaken":96,"photoUrl":97},"img-0894","IMG_0894","2024-12-05T11:01:00","/trips/2024-11-svalbard/photos/IMG_0894.jpeg",false,"2024-11-svalbard","2024-11-30T00:00:00.000Z","trips/2024-11-svalbard/index",[103,104,105],"arctic","hiking","solo","So8YGPIfeMfRfZsDweGHJoGiUeHrrSwoLT2Rtsep6ec",1773607576261]